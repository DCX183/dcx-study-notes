文件目录类命令
pwd--显示当前工作目录的绝对路径
ls--列出目录内容
ls -a--全部的文件，连同隐藏档（开头为.的文件）一起列出
ls -l--长数据串列出，包括文件的属性与权限  =ll
cd--切换路径
cd~或cd--回到自己家的目录
cd- --回到上一次所在的目录
cd.. --回到当前目录的上一级目录
cd -P --跳转到实际物理路径，而非快捷方式
cd/ --回到系统根目录
mkdir--建立目录
mkdir -p --创建多级目录
rmdir --删除空目录
touch --创建空文件
cp --复制文件或目录
cp -r --递归复制整个文件夹
\cp--强制覆盖不提示
rm--移除文件或目录
rm -r --递归删除目录所有内容
rm -f --强制删除，不提示用户进行确认
rm -v --显示指令的详细执行过程
mv--移动文件与目录或重命名
mv oldnamefile newnamefile--重命名
mv /temp/movefile/targetfolder--移动文件
cat--查看文件内容
cat -n --显示所有行行号，包括空行
less--分屏查看文件内容
head--显示文件头部内容（默认10行）
head -n 行数 --指定显示头部内容行数
tail输出文件尾部内容（默认10行）
tail -n 行数 --同head
tail -f --显示文件最近追加的内容，监视文件变化（默认10行）
echo打印信息
echo -e  --支持\控制的字符转换
控制字符
\\ -- 输出\本身
\n -- 换行符
\t -- 制表符，也就是tab键
> -- 覆盖
>> -- 追加
ln -- 创建链接
ln -s --创建软链接，想当于Windows的快捷方式（必须是绝对路径）
