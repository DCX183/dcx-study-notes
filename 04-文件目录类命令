文件目录类命令
cat--查看文件内容
cat -n --显示所有行行号，包括空行
less--分屏查看文件内容
head--显示文件头部内容（默认10行）
head -n 行数 --指定显示头部内容行数
tail输出文件尾部内容（默认10行）
tail -n 行数 --同head
tail -f --显示文件最近追加的内容，监视文件变化（默认10行）
echo打印信息
echo -e  --支持\控制的字符转换
控制字符
\\ -- 输出\本身
\n -- 换行符
\t -- 制表符，也就是tab键
> -- 覆盖
>> -- 追加
ln -- 创建链接
ln -s --创建软链接，想当于Windows的快捷方式（必须是绝对路径）
